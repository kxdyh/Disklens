    <Compile Include="..\..\src\DiskLens.App\Models\DriveScanOption.cs" Link="DriveScanOption.cs" />
    <Compile Include="..\..\src\DiskLens.App\Models\VisualExplorerPresentation.cs" Link="VisualExplorerPresentation.cs" />
    <Compile Include="..\..\src\DiskLens.App\Localization\L.cs" Link="Localization\L.cs" />
    <EmbeddedResource Include="..\..\src\DiskLens.App\Localization\keys.json" LogicalName="DiskLens.App.Localization.keys.json" />
