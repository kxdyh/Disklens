                                <TextBlock Text="{loc:Text s189}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Border Margin="0,12,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource CardSubtleBackgroundBrush}">
                                    <TextBlock Text="{loc:Bind ScanReportReconciliationText}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsDirectoryScanReport, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:Text s479}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Margin="0,8,0,8" FontSize="26" FontWeight="SemiBold" Text="{loc:Bind ScanReportRecognizedText}" />
                                <TextBlock Text="{loc:Text s291}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Margin="0,16,0,20" Text="{loc:Bind ScanReportStrategyText}" TextWrapping="Wrap"
                                       Visibility="{Binding HasScanReportPolicyNotes, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Separator Margin="0,18,0,18" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{loc:Text s609}" />
                            <TextBlock Margin="0,6,0,12" Text="{loc:Bind ScanReportIssueSummaryText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                            <ListBox x:Name="ScanReadIssuesList" Grid.Row="2" ItemsSource="{Binding ScanReadIssueRows}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     Visibility="{Binding HasScanReadIssues, Converter={StaticResource BoolToVisibilityConverter}}"
                                     AutomationProperties.Name="{loc:Text s640}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="IssueFocusRing" BorderThickness="1" BorderBrush="Transparent" CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="IssueFocusRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="IssueFocusRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                                Background="{DynamicResource CardSubtleBackgroundBrush}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{loc:Bind ReasonText}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBox Margin="0,6,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                                                         IsReadOnly="True" Text="{Binding Path, Mode=OneWay}" TextWrapping="Wrap"
                                                         AutomationProperties.Name="{loc:Text s610}" />
                                                <TextBlock Margin="0,5,0,0" Text="{loc:Bind DetailText}" TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2" Text="{loc:Bind ScanReportEmptyIssuesText}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasScanReadIssues}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="AiSetupOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="18"
              Visibility="Collapsed">
            <Border Background="Transparent" />
            <Border x:Name="AiSetupPanel" Width="760" MaxWidth="900" MaxHeight="760" Margin="24"
                    PreviewMouseWheel="SettingsComboBox_OnPreviewMouseWheel"
                    Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                    Tag="Y" RenderTransformOrigin="0.5,0.5"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <TranslateTransform />
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Margin="16,0,0,0" Padding="0" Width="36" Height="36" MinWidth="0"
                                Style="{StaticResource SubtleButtonStyle}" Command="{Binding CloseAiSetupCommand}"
                                ToolTip="{loc:Text s131}" AutomationProperties.Name="{loc:Text s130}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;" />
                        </Button>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{loc:Bind AiSetupTitle}" />
                            <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{loc:Text s622}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Grid x:Name="AiSetupContent" Grid.Row="1">
                        <Grid Margin="0,2,0,16" Visibility="{Binding ShowAiProviderChoices, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Padding="18" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Style="{StaticResource SubtleButtonStyle}" Command="{Binding ChooseDeepSeekCommand}"
                                    AutomationProperties.Name="{loc:Text s111}">
                                <Border Padding="18" Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="#335A92E8" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <Canvas Width="88" Height="66" HorizontalAlignment="Left" Margin="0,0,0,18">
                                            <Rectangle Canvas.Left="4" Canvas.Top="3" Width="80" Height="58" RadiusX="20" RadiusY="20"
                                                       Fill="#142033" Stroke="#F4F7FF" StrokeThickness="3" />
                                            <Ellipse Canvas.Left="21" Canvas.Top="20" Width="25" Height="25"
                                                     Stroke="#2E72F4" StrokeThickness="5" />
                                            <Ellipse Canvas.Left="50" Canvas.Top="20" Width="25" Height="25"
                                                     Stroke="#2E72F4" StrokeThickness="5" />
                                        </Canvas>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="DeepSeek" />
                                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{loc:Text s583}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="deepseek-flash  ·  medium" />
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Grid.Column="2" Padding="18" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Style="{StaticResource SubtleButtonStyle}" Command="{Binding ChooseCustomAiCommand}"
                                    AutomationProperties.Name="{loc:Text s647}">
                                <Border Padding="18" Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="#55EA8B52" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <Border Width="70" Height="66" HorizontalAlignment="Left" Margin="0,0,0,18"
                                                CornerRadius="14" Background="#22EA8B52" BorderBrush="#66EA8B52" BorderThickness="1">
                                            <Canvas Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Line X1="10" Y1="10" X2="31" Y2="20" Stroke="#F29A63" StrokeThickness="3" />
                                                <Line X1="10" Y1="32" X2="31" Y2="20" Stroke="#F29A63" StrokeThickness="3" />
                                                <Ellipse Canvas.Left="3" Canvas.Top="4" Width="14" Height="14" Fill="#F29A63" />
                                                <Ellipse Canvas.Left="3" Canvas.Top="25" Width="14" Height="14" Fill="#F29A63" />
                                                <Ellipse Canvas.Left="25" Canvas.Top="13" Width="14" Height="14" Fill="#F29A63" />
                                            </Canvas>
                                        </Border>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Text s584}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{loc:Text s627}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{loc:Text s53}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                        <Grid Margin="0,2,0,16" Visibility="{Binding ShowDeepSeekSetup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Button Margin="0,0,0,14" Padding="0" HorizontalAlignment="Left"
                                        Style="{StaticResource InlineActionButtonStyle}" Command="{Binding BackAiSetupCommand}"
                                        Content="{loc:Text s619}" />
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{loc:Text s217}" />
                                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{loc:Text s363}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,24,0,6" Style="{StaticResource SettingsLabelStyle}" Text="API Key" />
                                <PasswordBox x:Name="DeepSeekApiKeyPasswordBox" MinHeight="44" Padding="12,8"
                                             PasswordChanged="AiSetupApiKeyPasswordBox_OnPasswordChanged"
                                             AutomationProperties.Name="DeepSeek API Key" />
                                <TextBlock Margin="0,12,0,0" FontSize="13">
                                    <Hyperlink NavigateUri="https://platform.deepseek.com/api_keys"
                                               RequestNavigate="OfficialDocumentation_OnRequestNavigate"
                                               Foreground="{DynamicResource LinkBrush}"><Run Text="{loc:Text s172}" /></Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,18,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{loc:Text s230}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Margin="0,2,0,16" MaxHeight="510"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding ShowCustomAiSetup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="0,0,12,0">
                                <Button Margin="0,0,0,10" Padding="0" HorizontalAlignment="Left"
                                        Style="{StaticResource InlineActionButtonStyle}" Command="{Binding BackAiSetupCommand}"
                                        Content="{loc:Text s619}" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{loc:Text s218}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,6" Style="{StaticResource SettingsLabelStyle}" Text="{loc:Text s364}" />
                                <TextBox Text="{Binding AiSetupEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Text s364}" />
                                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{loc:Text s112}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,16,0,6" Style="{StaticResource SettingsLabelStyle}" Text="{loc:Text s492}" />
                                <TextBox Text="{Binding AiSetupModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Text s492}" />
                                <TextBlock Margin="0,16,0,6" Style="{StaticResource SettingsLabelStyle}" Text="API Key" />
                                <PasswordBox x:Name="CustomApiKeyPasswordBox" MinHeight="42" Padding="12,8"
                                             PasswordChanged="AiSetupApiKeyPasswordBox_OnPasswordChanged"
                                             AutomationProperties.Name="{loc:Text s586}" />
                                <TextBlock Margin="0,16,0,6" Style="{StaticResource SettingsLabelStyle}" Text="{loc:Text s308}" />
                                <ComboBox ItemsSource="{Binding AiReasoningEffortOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding AiSetupReasoningEffort, Mode=TwoWay}"
                                          AutomationProperties.Name="{loc:Text s587}" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{loc:Text s548}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <Border Padding="10" Background="{DynamicResource WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasAiSetupError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource WarningTextBrush}" Text="{loc:Bind AiSetupErrorText}"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        </Border>
                        <DockPanel Margin="0,16,0,0" LastChildFill="False">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{loc:Text s496}"
                                       Visibility="{Binding IsAiSetupSaving, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding CloseAiSetupCommand}" Content="{loc:Text s104}"
                                    Visibility="{Binding ShowAiProviderChoices, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding CloseAiSetupCommand}" Content="{loc:Text s193}"
                                    Visibility="{Binding ShowDeepSeekSetup, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding CloseAiSetupCommand}" Content="{loc:Text s193}"
                                    Visibility="{Binding ShowCustomAiSetup, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button DockPanel.Dock="Right" MinWidth="148" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveAiSetupAndAnalyzeCommand}" Content="{loc:Bind AiSetupSaveButtonText}"
                                    Visibility="{Binding ShowDeepSeekSetup, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button DockPanel.Dock="Right" MinWidth="148" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveAiSetupAndAnalyzeCommand}" Content="{loc:Bind AiSetupSaveButtonText}"
                                    Visibility="{Binding ShowCustomAiSetup, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="SharingEnabledToast" Panel.ZIndex="30" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24,76,24,0"
                Padding="16,12" CornerRadius="10" MaxWidth="420" IsHitTestVisible="False"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" Margin="0,0,10,0" FontSize="16" Foreground="{DynamicResource StatusSuccessBrush}" />
                <TextBlock x:Name="SharingEnabledToastText" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
