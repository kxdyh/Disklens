                                                <TextBlock Text="{loc:Bind SelectedAiReasonText}" TextWrapping="Wrap" MaxWidth="400" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Expander x:Name="AiResultsExpander" Grid.Row="2" Header=" " IsExpanded="False" Margin="0,0,0,4"
