                                                    <DataTrigger Binding="{Binding SelectedAiActionIsConsiderDelete}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="SelectedAiReasonText" Grid.Row="3" Margin="0,2,0,0"
