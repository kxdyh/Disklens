                                <ProgressBar x:Name="AiActivityProgressBar" Height="4" Margin="0,10,0,8" Maximum="100" Value="35"
                                             IsIndeterminate="{Binding IsAiActivityAnimated}"
                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrackBrush}"
                                             AutomationProperties.Name="{loc:Text s29}" />
                                <TextBlock Text="{loc:Bind AiProgressDetailText}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{loc:Bind AiCandidateProgressText}" Margin="0,7,0,4" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <ProgressBar x:Name="AiCandidateProgressBar" Height="3" Maximum="100" Value="{Binding AiCandidateProgressValue, Mode=OneWay}"
