<Window x:Class="DiskLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskLens.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DiskLens.App.Controls"
        xmlns:coreModels="clr-namespace:DiskLens.Core.Models;assembly=DiskLens.Core"
        xmlns:visual="clr-namespace:DiskLens.Core.Visualization;assembly=DiskLens.Core"
        mc:Ignorable="d"
        Title="{loc:Text s48}"
        Icon="/DiskLens.App;component/Resources/Brand/DiskLens.ico"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        Width="1440"
        Height="860"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_OnLoaded"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Back" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Home" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
    </Window.InputBindings>

    <Window.Resources>
<DataTemplate x:Key="LocalizedChoiceTemplate"><TextBlock Text="{loc:Bind .}" /></DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SharedExperienceEntryStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#173D37" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EntrySurface" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#B9E8DB" />
                                    <GradientStop Color="#DFE9B5" Offset="0.62" />
                                    <GradientStop Color="#EAE0F4" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EntrySurface" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="EntrySurface" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EntrySurface" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter TargetName="EntrySurface" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="ElasticTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="ElasticMutedTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource ElasticTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ElasticPathTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource ElasticTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="15" />
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="6" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Path Grid.Column="1" Margin="10,0,0,0" Width="9" Height="5" VerticalAlignment="Center"
                                      Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" />
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="None">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="HandDrawnButtonBaseStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource HandDrawnButtonBaseStyle}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HandDrawnButtonBaseStyle}">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="InlineActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HandDrawnButtonBaseStyle}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style x:Key="MiniActionButtonStyle" TargetType="Button" BasedOn="{StaticResource InlineActionButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="AnalysisSourceBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AnalysisSourceLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AnalysisSourceIconStyle" TargetType="TextBlock" BasedOn="{StaticResource AnalysisSourceLabelStyle}">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="AnalysisRiskStripStyle" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static coreModels:RiskLevel.Low}">
                    <Setter Property="Background" Value="{DynamicResource RiskLowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static coreModels:RiskLevel.Review}">
                    <Setter Property="Background" Value="{DynamicResource RiskReviewBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static coreModels:RiskLevel.High}">
                    <Setter Property="Background" Value="{DynamicResource RiskHighBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static coreModels:RiskLevel.Protected}">
                    <Setter Property="Background" Value="{DynamicResource RiskProtectedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScanProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999">
                            <Grid ClipToBounds="True">
                                <Rectangle x:Name="PART_IndicatorTrail"
                                           HorizontalAlignment="Left"
                                           RadiusX="999"
                                           RadiusY="999"
                                           Fill="{TemplateBinding Foreground}"
                                           Opacity="0.28"
                                           Width="288">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           RadiusX="999"
                                           RadiusY="999"
                                           Fill="{TemplateBinding Foreground}"
                                           Opacity="0.92"
                                           Width="132">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="PART_IndicatorTrail"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-320"
                                                             To="1100"
                                                             Duration="0:0:2.25" />
                                            <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-180"
                                                             To="1100"
                                                             Duration="0:0:1.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsIndeterminate" Value="False">
                                <Setter TargetName="PART_IndicatorTrail" Property="Width" Value="0" />
                                <Setter TargetName="PART_Indicator" Property="Width" Value="280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VisualTileCardStyle" TargetType="Border">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinHeight" Value="132" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource TileOtherBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Depth}" Value="0" />
                        <Condition Binding="{Binding Weight}" Value="{x:Static visual:VisualExplorerItemWeight.Hero}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Width" Value="360" />
                    <Setter Property="MinHeight" Value="220" />
                    <Setter Property="Margin" Value="0,0,14,14" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Depth}" Value="0" />
                        <Condition Binding="{Binding Weight}" Value="{x:Static visual:VisualExplorerItemWeight.Standard}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Width" Value="254" />
                    <Setter Property="MinHeight" Value="178" />
                    <Setter Property="Margin" Value="0,0,14,14" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Depth}" Value="0" />
                        <Condition Binding="{Binding Weight}" Value="{x:Static visual:VisualExplorerItemWeight.Compact}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Width" Value="172" />
                    <Setter Property="MinHeight" Value="128" />
                    <Setter Property="Margin" Value="0,0,14,14" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="1">
                    <Setter Property="MinHeight" Value="132" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="2">
                    <Setter Property="MinHeight" Value="124" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="3">
                    <Setter Property="MinHeight" Value="116" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="4">
                    <Setter Property="MinHeight" Value="108" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.UserSpace}">
                    <Setter Property="Background" Value="{DynamicResource TileUserSpaceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.UserFolder}">
                    <Setter Property="Background" Value="{DynamicResource TileUserFolderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.UserMoss}">
                    <Setter Property="Background" Value="{DynamicResource TileUserMossBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.UserSlate}">
                    <Setter Property="Background" Value="{DynamicResource TileUserSlateBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.System}">
                    <Setter Property="Background" Value="{DynamicResource TileSystemBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.SystemFolder}">
                    <Setter Property="Background" Value="{DynamicResource TileSystemFolderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.Applications}">
                    <Setter Property="Background" Value="{DynamicResource TileApplicationsBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.ApplicationsFolder}">
                    <Setter Property="Background" Value="{DynamicResource TileApplicationsFolderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.Shared}">
                    <Setter Property="Background" Value="{DynamicResource TileSharedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.SharedFolder}">
                    <Setter Property="Background" Value="{DynamicResource TileSharedFolderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Palette}" Value="{x:Static visual:VisualExplorerPalette.OtherFolder}">
                    <Setter Property="Background" Value="{DynamicResource TileOtherBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static visual:VisualExplorerItemKind.Aggregate}">
                    <Setter Property="Background" Value="{DynamicResource TileAggregateBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="VisualExplorerTileTemplate" DataType="{x:Type visual:VisualExplorerItem}">
            <Border Style="{StaticResource VisualTileCardStyle}"
                    Tag="{Binding DisplayNode}"
                    ToolTipService.InitialShowDelay="450"
                    ToolTipService.ShowDuration="30000"
                    MouseLeftButtonUp="VisualTile_OnMouseLeftButtonUp">
                <Border.ToolTip>
                    <ToolTip Placement="Mouse"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <Border MaxWidth="420"
                                Padding="13,11"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{loc:Bind DisplayNode, NodeName=True}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding SizeText}" />
                                <TextBlock Margin="0,0,0,7"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{loc:Bind SubtitleText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding TooltipPathText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,12,0"
                                   MinHeight="22"
                                   MaxHeight="42"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TileTextBrush}"
                                   Text="{loc:Bind DisplayNode, NodeName=True}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Foreground="{DynamicResource TileMutedTextBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding SizeText}" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource TileMutedTextBrush}"
                               FontSize="12"
                               Text="{loc:Bind SubtitleText}"
                               TextWrapping="Wrap" />

                    <Border Margin="0,10,0,0"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Text="{loc:Text s275}" />
                    </Border>

                    <ItemsControl Margin="0,12,0,0"
                                  ItemsSource="{Binding Children}"
