<Window x:Class="DiskLens.App.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskLens.App.Localization"
        Title="{loc:Text s47}" Width="550" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="Resources/Brand/DiskLens.ico" Background="{DynamicResource CardBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="14"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="25" FontWeight="SemiBold" Text="{loc:Text s432}" />
        <StackPanel Grid.Row="1" Margin="0,12,0,20">
            <TextBlock x:Name="VersionSummary" FontSize="15" />
            <TextBlock x:Name="ReleaseDate" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ReleaseNotes">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,0,8,12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="•" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{loc:Bind .}" TextWrapping="Wrap" LineHeight="22" />
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Margin="0,8,0,18" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" Text="{loc:Text s175}" />
        <StackPanel Grid.Row="4">
            <TextBlock x:Name="ActionError" Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusDangerBrush}" />
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="DismissUpdateButton" Content="{loc:Text s414}" Margin="0,0,8,0" IsCancel="True" Click="Dismiss_OnClick" />
                <Button x:Name="IgnoreUpdateButton" Content="{loc:Text s307}" Margin="0,0,8,0" Click="Ignore_OnClick" />
                <Button x:Name="OpenDownloadPageButton" Content="{loc:Text s174}" IsDefault="True" Click="Download_OnClick"
                        Background="{DynamicResource PrimaryButtonBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
